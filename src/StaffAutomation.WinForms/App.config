<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Encrypted connection string placeholder for LAN SQL Server Express -->
    <add name="StaffAutomationDb" 
         connectionString="Server=.\SQLEXPRESS;Database=StaffAutomationDb;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;Connect Timeout=15;Pooling=True;Max Pool Size=50;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  
  <appSettings>
    <add key="AppName" value="CA Office Workforce Productivity Automation System" />
    <add key="AutoSaveIntervalSeconds" value="60" />
    <add key="MaxDashboardRefreshMs" value="500" />
    <add key="LogFolderPath" value="logs" />
    <add key="UpdateManifestUrl" value="https://example.com/updates/manifest.json" />
    
    <!-- Live GSTIN Verification Provider Configuration (Official Sandbox.co.in GST Compliance API Flow) -->
    <!-- Provider Options: SandboxGstProvider | StatutoryFallback -->
    <add key="GstProviderType" value="SandboxGstProvider" />
    <add key="GstApiUrl" value="https://api.sandbox.co.in/gst/compliance/public/gstin/search" />
    <add key="GstApiKey" value="" />
    <add key="GstApiSecret" value="" />
  </appSettings>
</configuration>
